# Groq LLM (evaluation + question generation)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_EVALUATOR_MODEL=

# Deepgram STT (Pipecat voice path)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en
DEEPGRAM_ENDPOINTING_MS=500
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_KEYWORDS=FastAPI:1,Qdrant:1,Python:1,TensorFlow:1,scikit-learn:1

# Cartesia TTS (Pipecat voice path)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=2d1cc513-e4d7-466c-bb9a-cb7127e79391

# Pipecat WebSocket server
PIPECAT_WS_HOST=localhost
PIPECAT_WS_PORT=8765
REPORT_HTTP_PORT=8766

# Voice turn timing (InterviewProcessor)
TRANSCRIPT_DEBOUNCE_SECONDS=3.0
SHORT_ANSWER_GRACE_SECONDS=2.5
SHORT_ANSWER_WORD_THRESHOLD=6
STARTUP_AUDIO_GATE_SECONDS=4.0
STARTUP_REFRESH_SECONDS=3.0
BOT_ECHO_COOLDOWN_SECONDS=1.2
BOT_STOP_ECHO_COOLDOWN_SECONDS=0.8
CLOSING_DELAY_SECONDS=2.5
# After bot finishes a question: soft nudge, then rephrase (0 disables)
CANDIDATE_SILENCE_NUDGE_SECONDS=8.0
CANDIDATE_SILENCE_REPHRASE_SECONDS=15.0
# Ignore server VAD barge-in this long after bot TTS starts
BARGE_IN_MIN_BOT_SPEAK_SECONDS=0.25
FINAL_TRANSCRIPT_DEBOUNCE_SECONDS=0.35

# Logging
LOG_LEVEL=INFO
PROCESSOR_LOG_FRAMES=false
DEBUG_LIVE_LOGGING=false

# Optional PostgreSQL persistence
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer

# Dev-only: enable FastAPI text WebSocket simulation (not the product voice path)
ENABLE_DEV_TEXT_VOICE_WS=false

# Recruiter Dashboard (separate module on :8001)
# Base URL of the Candidate Interface used when generating invite links
CANDIDATE_ORIGIN=http://localhost:3000
